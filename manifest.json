{
  "manifest_version": 3,
  "name": "Pomodoro líquido",
  "version": "0.3.0",
  "description": "Organiza sesiones de estudio con un temporizador visual de líquido.",
  "permissions": ["storage"],
  "icons": {
    "48": "icons/recipiente-48.png",
    "96": "icons/recipiente-96.png"
  },
  "action": {
    "default_title": "Pomodoro líquido",
    "default_popup": "popup.html",
    "default_icon": "icons/recipiente-48.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pomodoro-liquido-pec3@pablo-morell.local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
